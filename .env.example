# ============================================================================
# ApplyEase Environment Configuration
# Copy this file to `.env` and fill in your own values.
# ============================================================================

# --- Supabase (required for cloud database sync) -----------------------------
# Two ways to connect — pick either, they are equivalent:
#   A. In the app (recommended): sign in as an administrator →
#      “Cloud & Data” → paste the Project URL + anon public key → Test & connect.
#      The connection is remembered in that browser, no rebuild required.
#   B. Here, before building: fill in the two values below and restart the
#      dev server. Useful when you deploy with your own credentials baked in.
#
# Either way: create a project at https://supabase.com first and run
# supabase/schema.sql in the SQL Editor.
# Leave these as placeholders to run ApplyEase in local demo mode.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
# Legacy projects can use the anon JWT instead:
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Gemini API (Aria assistant) --------------------------------------------
# Server-side key used by /api/chat (Vercel → Settings → Environment Variables).
# Never exposed to the browser. Recommended for any deployment.
GEMINI_API_KEY="your-gemini-api-key"

# Browser-side key, kept only as a local-development fallback for `npm run dev`.
# Vite inlines VITE_* into the public bundle at build time, so do not rely on it
# for a deployed site: anyone can read it, and adding it later needs a rebuild.
# VITE_GEMINI_API_KEY="your-gemini-api-key"

# Optional: pin a model if Google rotates the default
# GEMINI_MODEL="gemini-3.6-flash"

# --- Hosting -----------------------------------------------------------------
APP_URL="MY_APP_URL"
